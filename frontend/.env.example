# The normal Docker build enables chat-first automatically.
# This is a developer/test-only override for the maintained staged harness:
# VITE_VOLUNDR_CHAT_FIRST=false

# Opt into the product-facing validated design workflow in the browser.
# VITE_VOLUNDR_VALIDATED_CADQUERY_FLOW_ENABLED=false

# Playwright supplies harness ports and host values at runtime.

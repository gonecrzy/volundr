FROM node:22-slim AS build

WORKDIR /app
ARG VITE_VOLUNDR_CHAT_FIRST=true
ENV VITE_VOLUNDR_CHAT_FIRST=${VITE_VOLUNDR_CHAT_FIRST}
ARG VITE_VOLUNDR_VALIDATED_CADQUERY_FLOW_ENABLED=false
ENV VITE_VOLUNDR_VALIDATED_CADQUERY_FLOW_ENABLED=${VITE_VOLUNDR_VALIDATED_CADQUERY_FLOW_ENABLED}
ARG VITE_VOLUNDR_EXECUTABLE_CADQUERY_FLOW_ENABLED=false
ENV VITE_VOLUNDR_EXECUTABLE_CADQUERY_FLOW_ENABLED=${VITE_VOLUNDR_EXECUTABLE_CADQUERY_FLOW_ENABLED}

COPY package.json package-lock.json ./
RUN npm ci

COPY index.html tsconfig.json vite.config.ts ./
COPY src ./src
RUN npm run build

FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80

# Minimal production-like configuration
VOLUNDR_WEB_PORT=8080
VOLUNDR_API_BIND_ADDRESS=127.0.0.1
VOLUNDR_API_PORT=8000
VOLUNDR_DATA_DIR=./data
VOLUNDR_AI_PROVIDER=gemini_api
GEMINI_API_KEY=
VOLUNDR_GEMINI_MODEL=gemini-3.5-flash-lite
VOLUNDR_VALIDATED_GEOMETRY_PROVIDER=gemini_api
# Temporary Codex geometry comparison; credentials are API-container-only.
VOLUNDR_CODEX_API_BASE_URL=
VOLUNDR_CODEX_API_KEY=
VOLUNDR_CODEX_MODEL=
VOLUNDR_CODEX_API_MODE=responses
VOLUNDR_EXECUTABLE_CADQUERY_FLOW_ENABLED=false
# Staging validated-flow transport: primary is GEMINI_API_KEY_2; fallback is
# GEMINI_API_KEY after one primary-key HTTP 429. Values are never persisted.
# GEMINI_API_KEY_2=

# Optional provider: use these only when VOLUNDR_AI_PROVIDER=ollama.
# VOLUNDR_AI_PROVIDER=ollama
# VOLUNDR_OLLAMA_BASE_URL=http://127.0.0.1:11434
# VOLUNDR_OLLAMA_MODEL=qwen2.5-coder:14b
# VOLUNDR_OLLAMA_TIMEOUT_SECONDS=300
# VOLUNDR_OLLAMA_THINK=

# Advanced operational overrides. Defaults are safe for normal deployment.
# VOLUNDR_GEMINI_TIMEOUT_SECONDS=120
# VOLUNDR_CAD_TIMEOUT_SECONDS=60
# VOLUNDR_GEMINI_POLICY_PATH=
# VOLUNDR_SNAPSHOTS_ENABLED=true
# VOLUNDR_VALIDATED_CADQUERY_FLOW_ENABLED=false
# Normal browser traffic reaches the API through nginx, which overwrites the
# internal single-user actor header. Direct API access is disabled by default;
# enable this only for isolated local development and send the documented
# X-Volundr-Direct-Access: true header.
# VOLUNDR_VALIDATED_API_DIRECT_ACCESS_ENABLED=false

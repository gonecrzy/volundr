VOLUNDR_WEB_PORT=8080
VOLUNDR_API_PORT=8000
VOLUNDR_DATA_DIR=./data
VOLUNDR_CAD_WORKSPACE_DIR=./data/jobs
VOLUNDR_WORKFLOW_STALE_SECONDS=900
VOLUNDR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VOLUNDR_AI_PROVIDER=gemini_api
VOLUNDR_OLLAMA_BASE_URL=http://10.1.20.25:11434
VOLUNDR_OLLAMA_MODEL=qwen2.5-coder:14b
VOLUNDR_OLLAMA_TIMEOUT_SECONDS=300
# Optional for thinking-capable Ollama models: false, true, low, medium, high, or max.
VOLUNDR_OLLAMA_THINK=
VOLUNDR_GEMINI_DIR=./data/gemini
VOLUNDR_GEMINI_BINARY=gemini
VOLUNDR_GEMINI_MODEL=gemini-3.5-flash-lite
# Optional prompt-stage overrides; unset values use VOLUNDR_GEMINI_MODEL.
VOLUNDR_GEMINI_REQUIREMENTS_MODEL=
VOLUNDR_GEMINI_DESIGN_PLAN_MODEL=
VOLUNDR_GEMINI_GEOMETRY_MODEL=
VOLUNDR_GEMINI_GEOMETRY_REPAIR_MODEL=
VOLUNDR_GEMINI_REVISION_PLANNING_MODEL=
VOLUNDR_GEMINI_COMPONENT_REVISION_MODEL=
VOLUNDR_GEMINI_TIMEOUT_SECONDS=120
VOLUNDR_GEMINI_POLICY_PATH=
GEMINI_API_KEY=
VOLUNDR_GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
VOLUNDR_GEMINI_API_TEMPERATURE=0.2
VOLUNDR_GEMINI_API_MAX_OUTPUT_TOKENS=8192
# Direct Gemini API only. Use minimal for source generation; set empty/off to omit.
VOLUNDR_GEMINI_API_THINKING_LEVEL=minimal
VOLUNDR_GEMINI_API_MAX_RETRIES=2
VOLUNDR_GEMINI_API_MAX_RETRY_SLEEP_SECONDS=60
VOLUNDR_CAD_TIMEOUT_SECONDS=60
VOLUNDR_MAX_SOURCE_BYTES=512000
VOLUNDR_MAX_STL_BYTES=104857600
VOLUNDR_GENERATION_MODE=advanced
VOLUNDR_ENABLE_DESIGN_PLANS=true
VOLUNDR_ENABLE_MULTI_OUTPUT=true
VOLUNDR_ENABLE_STRUCTURED_REVISIONS=true
VOLUNDR_CHAT_FIRST=true
VOLUNDR_SNAPSHOTS_ENABLED=true
VOLUNDR_SNAPSHOT_IMAGE_WIDTH=768
VOLUNDR_SNAPSHOT_IMAGE_HEIGHT=768
VOLUNDR_SNAPSHOT_TIMEOUT_SECONDS=30
VOLUNDR_SNAPSHOT_MAX_WHOLE_DESIGN_VIEWS=5
VOLUNDR_SNAPSHOT_MAX_COMPONENTS=24
VOLUNDR_SNAPSHOT_SECTION_ENABLED=true
VOLUNDR_SNAPSHOT_BACKGROUND=neutral_light
VITE_VOLUNDR_GENERATION_MODE=advanced
VITE_VOLUNDR_CHAT_FIRST=true

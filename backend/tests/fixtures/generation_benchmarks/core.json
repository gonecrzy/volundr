{
  "suite": "core",
  "benchmarks": [
    {
      "id": "simple_mounting_plate",
      "suite": "core",
      "input_prompt": "Create an 80 mm by 35 mm by 6 mm mounting plate with two M4 clearance holes spaced 55 mm apart along the long axis.",
      "required_dimensions": ["plate_width=80 mm", "plate_depth=35 mm", "plate_thickness=6 mm", "hole_diameter=4.5 mm", "hole_spacing=55 mm"],
      "allowed_assumptions": ["edge margins are calculated from plate size and hole spacing", "$fn may be 48"],
      "expected_clarification": "none",
      "expected_modules": ["main_body", "mounting_holes"],
      "expected_parameters": ["plate_width", "plate_depth", "plate_thickness", "hole_diameter", "hole_spacing"],
      "expected_printability_constraints": ["flat on Z=0", "no supports expected"],
      "compile_expectation": "success_without_repair",
      "mesh_expectation": "watertight one component with nonzero volume",
      "expected_geometric_invariants": [
        {"type": "bounds", "x_mm": 80, "y_mm": 35, "z_mm": 6, "verification": "verified"},
        {"type": "hole_group", "feature_id": "mounting_holes", "count": 2, "diameter_mm": 4.5, "spacing_mm": 55, "axis": "z", "verification": "verified"},
        {"type": "build_plate", "min_z_mm": 0, "verification": "verified"}
      ],
      "revision_expectation": "hole spacing revision changes only hole locations",
      "protected_design_invariants": ["plate width", "plate depth", "plate thickness", "hole diameter", "Z=0 placement"],
      "unacceptable_outcomes": ["missing holes", "wrong spacing", "geometry below Z=0", "unparameterized dimensions"]
    },
    {
      "id": "cylindrical_holder",
      "suite": "core",
      "input_prompt": "Create a desk cup holder for a 74 mm diameter cup, 65 mm tall, with 1 mm clearance and a 4 mm thick base.",
      "required_dimensions": ["cup_diameter=74 mm", "fit_clearance=1 mm", "holder_height=65 mm", "base_thickness=4 mm"],
      "allowed_assumptions": ["wall_thickness=3 mm", "open top"],
      "expected_clarification": "none",
      "expected_modules": ["outer_shell", "inner_cavity"],
      "expected_parameters": ["cup_diameter", "fit_clearance", "wall_thickness", "holder_height", "base_thickness"],
      "expected_printability_constraints": ["open top", "no unsupported internal ceiling"],
      "compile_expectation": "success_without_repair",
      "mesh_expectation": "watertight holder body",
      "expected_geometric_invariants": [
        {"type": "bounds", "z_mm": 69, "verification": "verified_or_unverifiable"},
        {"type": "wall_thickness", "value_mm": 3, "verification": "verified_or_warning"},
        {"type": "build_plate", "min_z_mm": 0, "verification": "verified"}
      ],
      "revision_expectation": "cup diameter revision preserves wall and base thickness",
      "protected_design_invariants": ["base thickness", "wall thickness", "open top", "Z=0 placement"],
      "unacceptable_outcomes": ["closed cup cavity", "unsupported top cap", "missing clearance"]
    },
    {
      "id": "spacer_bushing",
      "suite": "core",
      "input_prompt": "Create a 12 mm tall bushing with 8 mm outer diameter and 4.2 mm through hole.",
      "required_dimensions": ["height=12 mm", "outer_diameter=8 mm", "inner_diameter=4.2 mm"],
      "allowed_assumptions": ["$fn may be 64"],
      "expected_clarification": "none",
      "expected_modules": ["bushing_body", "through_hole"],
      "expected_parameters": ["outer_diameter", "inner_diameter", "height"],
      "expected_printability_constraints": ["vertical cylinder on Z=0"],
      "compile_expectation": "success_without_repair",
      "mesh_expectation": "watertight ring with one component",
      "expected_geometric_invariants": [
        {"type": "bounds", "z_mm": 12, "verification": "verified"},
        {"type": "hole", "diameter_mm": 4.2, "axis": "z", "verification": "verified"},
        {"type": "build_plate", "min_z_mm": 0, "verification": "verified"}
      ],
      "revision_expectation": "height revision preserves diameters",
      "protected_design_invariants": ["outer diameter", "inner diameter", "centered through hole"],
      "unacceptable_outcomes": ["solid cylinder with no hole", "off-center hole"]
    },
    {
      "id": "critical_dimension_revision",
      "suite": "core",
      "input_prompt": "Initial: Create an 80 x 35 x 6 mm mounting plate with two M4 clearance holes spaced 55 mm apart. Revision: Change the hole spacing to 60 mm and keep everything else the same.",
      "required_dimensions": ["initial_hole_spacing=55 mm", "revised_hole_spacing=60 mm"],
      "allowed_assumptions": ["none beyond initial generation assumptions"],
      "expected_clarification": "none",
      "expected_modules": ["main_body", "mounting_holes"],
      "expected_parameters": ["hole_spacing"],
      "expected_printability_constraints": ["unchanged flat plate orientation"],
      "compile_expectation": "success_without_repair",
      "mesh_expectation": "same plate bounds after revision",
      "expected_geometric_invariants": [
        {"type": "hole_group", "feature_id": "mounting_holes", "count": 2, "spacing_mm": 60, "axis": "z", "verification": "verified"},
        {"type": "bounds", "x_mm": 80, "y_mm": 35, "z_mm": 6, "verification": "verified"}
      ],
      "revision_expectation": "minimal diff changes hole_spacing only",
      "protected_design_invariants": ["plate width", "plate depth", "plate thickness", "hole diameter", "module names"],
      "expected_configuration": {
        "editable_parameters": ["hole_spacing"],
        "requested_overrides": {"hole_spacing": 60},
        "expected_affected_parameters": ["hole_spacing"],
        "expected_affected_components": ["plate"],
        "expected_affected_outputs": ["plate_output"],
        "expected_validation_state": "configuration_ready",
        "expected_defines": {"hole_spacing": 60},
        "provider_call_forbidden": true
      },
      "unacceptable_outcomes": ["plate resized", "hole diameter changed", "whole-model rewrite"]
    },
    {
      "id": "vague_clarification",
      "suite": "core",
      "input_prompt": "Make me a bracket for my shelf.",
      "required_dimensions": ["unknown shelf dimensions", "unknown load", "unknown fasteners"],
      "allowed_assumptions": ["none"],
      "expected_clarification": "required",
      "expected_modules": ["none_until_clarified"],
      "expected_parameters": ["none_until_clarified"],
      "expected_printability_constraints": ["not applicable until clarified"],
      "compile_expectation": "no_scad_generated",
      "mesh_expectation": "none",
      "expected_geometric_invariants": [],
      "revision_expectation": "not applicable",
      "protected_design_invariants": ["no accepted SCAD before clarification"],
      "unacceptable_outcomes": ["generic bracket accepted", "silent load assumption"]
    },
    {
      "id": "conflicting_dimensions",
      "suite": "core",
      "input_prompt": "Create a 50 mm wide spacer that is 80 mm wide with a 10 mm center hole.",
      "required_dimensions": ["width conflict: 50 mm vs 80 mm", "center_hole=10 mm"],
      "allowed_assumptions": ["none"],
      "expected_clarification": "required",
      "expected_modules": ["none_until_clarified"],
      "expected_parameters": ["none_until_clarified"],
      "expected_printability_constraints": ["not applicable until clarified"],
      "compile_expectation": "no_scad_generated",
      "mesh_expectation": "none",
      "expected_geometric_invariants": [],
      "revision_expectation": "not applicable",
      "protected_design_invariants": ["conflict must not be silently resolved"],
      "unacceptable_outcomes": ["choosing either width silently", "accepted SCAD"]
    },
    {
      "id": "creative_fish_shelf_bracket",
      "suite": "core",
      "input_prompt": "Create a 90 degree shelf bracket with an 80 mm wall leg, 70 mm shelf leg, 18 mm width, 5 mm material thickness, two wall mounting holes, two shelf mounting holes, and make the visible underside silhouette look like a fish.",
      "required_dimensions": ["wall_leg_length=80 mm", "shelf_leg_length=70 mm", "bracket_width=18 mm", "material_thickness=5 mm", "wall_hole_count=2", "shelf_hole_count=2"],
      "allowed_assumptions": ["hole_diameter=4.5 mm for M4 clearance", "fish styling may use bounded outline relief, fins, tail, or local silhouette shaping away from mounting faces"],
      "expected_clarification": "none",
      "expected_modules": ["functional_l_bracket_core", "wall_mounting_holes", "shelf_mounting_holes", "fish_silhouette"],
      "expected_parameters": ["wall_leg_length", "shelf_leg_length", "bracket_width", "material_thickness", "hole_diameter", "fish_style"],
      "expected_printability_constraints": ["functional mounting faces remain flat", "decorative features do not sever load path"],
      "compile_expectation": "success_without_repair",
      "mesh_expectation": "one connected 90 degree bracket with visible fish underside styling",
      "expected_geometric_invariants": [
        {"type": "hole_group", "feature_id": "wall_mounting_holes", "count": 2, "diameter_mm": 4.5, "axis": "x", "verification": "verified_or_warning"},
        {"type": "hole_group", "feature_id": "shelf_mounting_holes", "count": 2, "diameter_mm": 4.5, "axis": "z", "verification": "verified_or_warning"},
        {"type": "build_plate", "min_z_mm": 0, "verification": "verified_or_warning"}
      ],
      "revision_expectation": "style changes preserve hole count, bracket legs, and flat mounting faces",
      "protected_design_invariants": ["true 90 degree bracket", "wall mounting holes", "shelf mounting holes", "flat mounting faces", "visible underside fish silhouette"],
      "unacceptable_outcomes": ["plain L bracket with no fish-like underside", "decorative fish that is disconnected from bracket", "fish cutouts remove mounting faces", "holes modeled as positive cylinders instead of subtractive cuts"]
    },
    {
      "id": "honeycomb_angle_bracket",
      "suite": "core",
      "input_prompt": "Create a 90 degree angle bracket with two 80 x 45 x 5 mm flanges, four M5 clearance mounting holes, a triangular reinforcing rib, and a hexagonal honeycomb lightening pattern on the broad faces while keeping solid borders around edges and holes.",
      "required_dimensions": ["flange_length=80 mm", "flange_width=45 mm", "material_thickness=5 mm", "hole_diameter=5.2 mm", "hole_count=4", "solid_border>=6 mm"],
      "allowed_assumptions": ["rib_thickness=5 mm", "hex_flat_to_flat=10 mm", "hole bosses may remain solid"],
      "expected_clarification": "none",
      "expected_modules": ["angle_bracket_core", "mounting_holes", "reinforcing_rib", "honeycomb_cutouts"],
      "expected_parameters": ["flange_length", "flange_width", "material_thickness", "hole_diameter", "hex_flat_to_flat", "border_thickness"],
      "expected_printability_constraints": ["one connected body", "solid borders around holes and outer edges"],
      "compile_expectation": "success_without_repair",
      "mesh_expectation": "connected L bracket with real honeycomb cutouts and mounting holes",
      "expected_geometric_invariants": [
        {"type": "hole_group", "feature_id": "mounting_holes", "count": 4, "diameter_mm": 5.2, "verification": "verified_or_warning"},
        {"type": "wall_thickness", "value_mm": 5, "verification": "verified_or_warning"}
      ],
      "revision_expectation": "honeycomb size changes preserve hole bosses, borders, and 90 degree core",
      "protected_design_invariants": ["true 90 degree bracket", "four M5 clearance holes", "triangular reinforcing rib", "hexagonal lightening pattern", "solid edge and hole borders"],
      "unacceptable_outcomes": ["honeycomb represented as surface decoration only", "honeycomb cuts pass through mounting bosses", "missing rib", "holes missing or not through holes"]
    },
    {
      "id": "threaded_control_knob",
      "suite": "core",
      "input_prompt": "Create a 32 mm diameter knurled control knob, 18 mm tall, with an M6x1 internal threaded hole through the center, a pointer indicator line on top, and editable diameter, height, and thread spec.",
      "required_dimensions": ["knob_diameter=32 mm", "knob_height=18 mm", "internal_thread=M6x1", "thread_axis=z"],
      "allowed_assumptions": ["BOSL2/threading allowed when curated library support is enabled", "knurling may be diamond or straight grip texture", "$fn may be 64"],
      "expected_clarification": "none",
      "expected_modules": ["knob_body", "knurled_grip", "internal_thread", "pointer_indicator"],
      "expected_parameters": ["knob_diameter", "knob_height", "thread_spec", "indicator_width"],
      "expected_printability_constraints": ["central hole remains open through the knob", "knurling does not create disconnected fragments"],
      "compile_expectation": "success_without_repair",
      "mesh_expectation": "single knob body with functional center threaded hole and visible grip texture",
      "expected_geometric_invariants": [
        {"type": "bounds", "x_mm": 32, "y_mm": 32, "z_mm": 18, "verification": "verified_or_warning"},
        {"type": "hole", "axis": "z", "verification": "verified_or_warning"}
      ],
      "revision_expectation": "diameter and thread spec revisions preserve pointer indicator and grip texture",
      "protected_design_invariants": ["central threaded through hole", "visible knurled grip", "top pointer indicator", "editable thread_spec parameter"],
      "unacceptable_outcomes": ["solid knob with no center hole", "hand-rolled fake threads accepted as functional threads", "decorative ribs only with no grip texture", "thread spec not parameterized"]
    }
  ]
}

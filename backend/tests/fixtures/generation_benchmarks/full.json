      "expected_modules": ["none_until_clarified"],
      "expected_parameters": ["none_until_clarified"],
      "expected_printability_constraints": ["not applicable until clarified"],
      "compile_expectation": "no_scad_generated",
      "mesh_expectation": "none",
      "revision_expectation": "not applicable",
      "protected_design_invariants": ["no accepted SCAD before clarification"],

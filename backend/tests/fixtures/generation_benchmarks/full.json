    {
      "id": "conflicting_dimensions",
      "suite": "full",
      "input_prompt": "Create a 50 mm wide spacer that is 80 mm wide with a 10 mm center hole.",
      "required_dimensions": ["width conflict: 50 mm vs 80 mm", "center_hole=10 mm"],

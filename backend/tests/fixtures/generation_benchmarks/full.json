{
  "suite": "full",
  "benchmarks": [
    {
      "id": "simple_mounting_plate",
      "suite": "full",
      "input_prompt": "Create an 80 mm by 35 mm by 6 mm mounting plate with two M4 clearance holes spaced 55 mm apart along the long axis.",
      "required_dimensions": ["plate_width=80 mm", "plate_depth=35 mm", "plate_thickness=6 mm", "hole_diameter=4.5 mm", "hole_spacing=55 mm"],
      "allowed_assumptions": ["edge margins calculated", "$fn may be 48"],
      "expected_clarification": "none",
      "expected_modules": ["main_body", "mounting_holes"],
      "expected_parameters": ["plate_width", "plate_depth", "plate_thickness", "hole_diameter", "hole_spacing"],
      "expected_printability_constraints": ["flat on Z=0", "no supports"],
      "compile_expectation": "success_without_repair",
      "mesh_expectation": "watertight one component",
      "revision_expectation": "hole spacing revision preserves all other dimensions",
      "protected_design_invariants": ["plate dimensions", "hole diameter", "Z=0 placement"],
      "unacceptable_outcomes": ["missing holes", "wrong spacing", "geometry below Z=0"]
    },
    {
      "id": "cylindrical_holder",
      "suite": "full",
      "input_prompt": "Create a desk cup holder for a 74 mm diameter cup, 65 mm tall, with 1 mm clearance and a 4 mm thick base.",
      "required_dimensions": ["cup_diameter=74 mm", "fit_clearance=1 mm", "holder_height=65 mm", "base_thickness=4 mm"],
      "allowed_assumptions": ["wall_thickness=3 mm", "open top"],
      "expected_clarification": "none",
      "expected_modules": ["outer_shell", "inner_cavity"],
      "expected_parameters": ["cup_diameter", "fit_clearance", "wall_thickness", "holder_height", "base_thickness"],
      "expected_printability_constraints": ["open top", "no unsupported ceiling"],
      "compile_expectation": "success_without_repair",
      "mesh_expectation": "watertight holder body",
      "revision_expectation": "cup diameter revision preserves wall/base",
      "protected_design_invariants": ["base thickness", "wall thickness", "open top"],
      "unacceptable_outcomes": ["closed cavity", "unsupported top cap", "missing clearance"]
    },
    {
      "id": "box_with_lid",
      "suite": "full",
      "input_prompt": "Create a small electronics box with an internal space 100 x 60 x 30 mm and a removable slip-on lid.",
      "required_dimensions": ["internal_width=100 mm", "internal_depth=60 mm", "internal_height=30 mm"],
      "allowed_assumptions": ["wall_thickness=3 mm", "lid_clearance=0.4 mm", "lid_lip=8 mm"],
      "expected_clarification": "optional",
      "expected_modules": ["box_body", "lid", "lid_lip"],
      "expected_parameters": ["inner_width", "inner_depth", "inner_height", "wall_thickness", "lid_clearance"],
      "expected_printability_constraints": ["open body", "lid printable flat", "no trapped support-only cavity"],
      "compile_expectation": "success_without_repair",
      "mesh_expectation": "intentional body and lid components documented",
      "revision_expectation": "mounting boss revision preserves internal volume",
      "protected_design_invariants": ["internal volume", "lid clearance", "body opening"],
      "unacceptable_outcomes": ["sealed box", "no lid clearance", "unsupported roof"]
    },
    {
      "id": "spacer_bushing",
      "suite": "full",
      "input_prompt": "Create a 12 mm tall bushing with 8 mm outer diameter and 4.2 mm through hole.",
      "required_dimensions": ["height=12 mm", "outer_diameter=8 mm", "inner_diameter=4.2 mm"],
      "allowed_assumptions": ["$fn may be 64"],
      "expected_clarification": "none",
      "expected_modules": ["bushing_body", "through_hole"],
      "expected_parameters": ["outer_diameter", "inner_diameter", "height"],
      "expected_printability_constraints": ["vertical cylinder on Z=0"],
      "compile_expectation": "success_without_repair",
      "mesh_expectation": "watertight ring",
      "revision_expectation": "height revision preserves diameters",
      "protected_design_invariants": ["outer diameter", "inner diameter", "centered through hole"],
      "unacceptable_outcomes": ["solid cylinder", "off-center hole"]
    },
    {
      "id": "hose_adapter",
      "suite": "full",
      "input_prompt": "Create a hose adapter from 19 mm ID hose to 25 mm ID hose with barbs.",
      "required_dimensions": ["small_hose_id=19 mm", "large_hose_id=25 mm"],
      "allowed_assumptions": ["barb_height=1.2 mm", "three barbs per side", "wall_thickness=3 mm"],
      "expected_clarification": "optional",
      "expected_modules": ["hose_barb_section", "transition_cone", "through_bore"],
      "expected_parameters": ["small_hose_id", "large_hose_id", "barb_height", "wall_thickness"],

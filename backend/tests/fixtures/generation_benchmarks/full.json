    {
      "id": "inaccessible_internal_cavity",
      "suite": "full",
      "input_prompt": "Create a sealed hollow float, 80 mm diameter, with 2 mm walls.",
      "required_dimensions": ["outer_diameter=80 mm", "wall_thickness=2 mm"],

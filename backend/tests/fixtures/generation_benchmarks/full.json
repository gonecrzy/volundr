      "revision_expectation": "slot width revision adjusts tongue only",
      "protected_design_invariants": ["T-track mating geometry", "bolt hole", "tongue thickness"],
      "unacceptable_outcomes": ["generic cube with hole", "no mating geometry"]
    },
    {
      "id": "replacement_handle",
      "suite": "full",
      "input_prompt": "Create a replacement drawer handle with 96 mm screw spacing and a rounded grip.",
      "required_dimensions": ["screw_spacing=96 mm"],

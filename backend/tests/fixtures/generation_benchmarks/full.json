      "revision_expectation": "screw spacing revision preserves grip diameter",
      "protected_design_invariants": ["screw spacing", "screw access", "grip connection"],
      "unacceptable_outcomes": ["tangent handle feet", "no screw access"]
    },
    {
      "id": "countersunk_holes",
      "suite": "full",
      "input_prompt": "Create a 60 x 30 x 5 mm plate with two countersunk M3 holes 40 mm apart.",
      "required_dimensions": ["plate=60x30x5 mm", "hole_spacing=40 mm", "M3 clearance"],
      "allowed_assumptions": ["shaft_clearance=3.4 mm", "head_diameter=6.2 mm", "countersink_depth=2 mm"],
      "expected_clarification": "none",
      "expected_modules": ["countersunk_hole", "mounting_holes"],
      "expected_parameters": ["shaft_clearance", "head_diameter", "head_depth", "hole_spacing"],
      "expected_printability_constraints": ["flat plate", "countersinks on top"],
      "compile_expectation": "success_without_repair",
      "mesh_expectation": "watertight with through holes",
      "revision_expectation": "head diameter revision preserves shaft holes",
      "protected_design_invariants": ["plate dimensions", "hole spacing", "through holes"],
      "unacceptable_outcomes": ["blind holes", "wrong countersink side"]
    },
    {
      "id": "critical_dimension_revision",
      "suite": "full",
      "input_prompt": "Initial: Create an 80 x 35 x 6 mm mounting plate with two M4 clearance holes spaced 55 mm apart. Revision: Change the hole spacing to 60 mm and keep everything else the same.",
      "required_dimensions": ["initial_hole_spacing=55 mm", "revised_hole_spacing=60 mm"],
      "allowed_assumptions": ["none beyond initial assumptions"],
      "expected_clarification": "none",
      "expected_modules": ["main_body", "mounting_holes"],
      "expected_parameters": ["hole_spacing"],
      "expected_printability_constraints": ["flat plate orientation unchanged"],
      "compile_expectation": "success_without_repair",
      "mesh_expectation": "same plate bounds after revision",
      "revision_expectation": "minimal diff changes hole_spacing only",
      "protected_design_invariants": ["plate dimensions", "hole diameter", "module names"],
      "unacceptable_outcomes": ["plate resized", "hole diameter changed", "whole rewrite"]
    },
    {
      "id": "new_feature_revision",
      "suite": "full",
      "input_prompt": "Initial: Create a 100 x 50 x 4 mm drill template with two 5 mm holes 70 mm apart. Revision: Add a 10 mm hanging hole centered 8 mm from the top edge.",
      "required_dimensions": ["plate=100x50x4 mm", "original_holes=5 mm", "original_spacing=70 mm", "hanging_hole=10 mm", "top_offset=8 mm"],
      "allowed_assumptions": ["hanging hole through full thickness"],
      "expected_clarification": "none",
      "expected_modules": ["drill_holes", "hanging_hole"],
      "expected_parameters": ["hanging_hole_diameter", "hanging_hole_edge_offset"],
      "expected_printability_constraints": ["flat plate"],
      "compile_expectation": "success_without_repair",
      "mesh_expectation": "one component",
      "revision_expectation": "new hole added without moving original holes",
      "protected_design_invariants": ["original hole size", "original hole spacing", "plate size"],
      "unacceptable_outcomes": ["moving original holes", "decorative slots"]
    },
    {
      "id": "vague_clarification",
      "suite": "full",
      "input_prompt": "Make me a bracket for my shelf.",
      "required_dimensions": ["unknown shelf dimensions", "unknown load", "unknown fasteners"],
      "allowed_assumptions": ["none"],

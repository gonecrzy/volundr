# Backend-only minimal configuration. The root .env.example is the normal
# Docker Compose configuration.
VOLUNDR_DATA_DIR=./data
VOLUNDR_AI_PROVIDER=gemini_api
VOLUNDR_GEMINI_MODEL=gemini-3.5-flash-lite
VOLUNDR_GEMINI_PRIMARY_API_KEY=
VOLUNDR_GEMINI_FALLBACK_API_KEY=
VOLUNDR_EXECUTABLE_CADQUERY_FLOW_ENABLED=false
# These are resolved API-container settings. The executable transport owns
# primary/fallback selection and rotates only after HTTP 429.

# Optional provider: use these only when VOLUNDR_AI_PROVIDER=ollama.
# VOLUNDR_AI_PROVIDER=ollama
# VOLUNDR_OLLAMA_BASE_URL=http://127.0.0.1:11434
# VOLUNDR_OLLAMA_MODEL=qwen2.5-coder:14b

# Advanced overrides are documented in docs/ENVIRONMENT_VARIABLES.md.
